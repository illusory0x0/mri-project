{
  "name": "lisp-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Stateless structural editor for a Lisp subset",
  "packageManager": "pnpm@10.13.1",
  "bin": {
    "lisp-editor": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "rm -rf dist && esbuild 'src/**/*.ts' 'eval/**/*.ts' 'test/**/*.ts' --outdir=dist --outbase=. --platform=node --target=node22 --format=esm",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && node --test dist/test/*.test.js",
    "eval": "pnpm run build && node dist/eval/run.js",
    "report": "pnpm run build && node dist/eval/report.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
